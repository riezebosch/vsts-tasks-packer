    "fs": "0.0.1-security"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/mocha-runner": "^10.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.5.1",
    "@types/q": "^1.5.8",
    "@types/sinon": "^22.0.0",
    "chai": "^6.2.2",
    "memory-streams": "^0.1.3",
    "mocha": "^12.0.1",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2"
  }
